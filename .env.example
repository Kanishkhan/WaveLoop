# Copy to .env.local for `npm run dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values. None of these are ever sent to the browser.

# Supabase → Project Settings → API. Leave both empty locally to use the built-in local Postgres.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Passcode for the command center (admin.html).
ADMIN_PASSCODE=

# Anthropic API key for the AI message writer. Leave empty to use the built-in templates.
LLM_API_KEY=
# Optional: override the model (default claude-opus-5-5).
# LLM_MODEL=
